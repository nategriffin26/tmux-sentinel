# ==============================================================================
# tmux-sentinel — default options
#
# This file is the configuration reference. It is sourced by sentinel.tmux with
# `set -ogq`, which sets an option only if it has not been set already. Because
# your own `.tmux.conf` is read before plugins run, any explicit
# `set -g @sentinel_*` you write there always wins over these defaults.
#
# Precedence, lowest to highest:
#   1. this file
#   2. ~/.config/tmux-sentinel/options.conf   (written by the CLI/TUI)
#   3. your .tmux.conf                        (explicit `set -g`)
#
# Every value is domain-validated by scripts/generate.sh. A value outside its
# stated domain is replaced by the default here and reported via
# `tmux display-message`; it is never interpolated into generated config.
# Values may never contain a carriage return or newline.
#
# Do not edit this file. Put overrides in .tmux.conf or in options.conf.
# ==============================================================================

# Colour palette. Domain: a filename stem in the plugin's themes/ directory,
# matching [a-z0-9-]+ and resolving to themes/<stem>.palette.
# Shipped: catppuccin-mocha, catppuccin-macchiato, catppuccin-frappe,
# catppuccin-latte, dracula, gruvbox-dark, monokai-pro, nord, one-dark,
# rose-pine, solarized-dark, tokyo-night.
set -ogq @sentinel_theme "catppuccin-mocha"

# Which edge of the terminal the status bar occupies. Domain: top | bottom.
set -ogq @sentinel_position "top"

# Seconds between status-bar redraws. Domain: integer 1..3600. Lower values
# cost one `sentinel-status` run each; 10 is comfortable, 1 is a stress test.
set -ogq @sentinel_interval "10"

# Icon vocabulary. Domain: nerd | unicode | ascii, resolving to
# glyphs/<mode>.glyphs. Use `nerd` only with a patched font; `unicode` needs a
# font with box-drawing and symbol coverage; `ascii` is safe everywhere.
set -ogq @sentinel_glyphs "nerd"

# Quiet mode. Domain: on | off. When `on`, the ambient-health segments
# (thermal, disk, battery) stay hidden until they cross a threshold, so the bar
# is empty of noise and a visible segment always means something. When `off`,
# every enabled segment renders continuously.
set -ogq @sentinel_alerts_only "on"

# Segments to render, in the fixed order thermal, sleep_risk, disk, battery,
# cpu, memory, multi_client, clock. Domain: comma-separated list with no
# spaces, drawn from exactly those eight names. Omitting a name disables it.
set -ogq @sentinel_segments "thermal,sleep_risk,disk,battery,cpu,memory,multi_client,clock"

# Window list style. Domain: hidden | minimal | tabs.
#   hidden  — no window list at all; the bar shows session identity and health.
#   minimal — dim `index:name`, current window in the accent colour.
#   tabs    — filled tab blocks with a highlighted current window.
set -ogq @sentinel_windows "hidden"

# Clock format, rendered by sentinel-status via strftime. Domain: 1..32
# characters matching ^[%A-Za-z0-9 :/.,+-]{1,32}$ — that is, strftime
# conversions plus alphanumerics, spaces and the punctuation `: / . , + -`.
# Anything else (quotes, backslashes, `$`, `;`, `#`, newlines) is rejected.
set -ogq @sentinel_clock_format "%H:%M"

# Truncation width for the session name on the left. Domain: integer 1..64.
# Longer names are cut and given a trailing ellipsis by tmux.
set -ogq @sentinel_session_max_length "18"

# The mode-indicator mark at the far left, which changes colour for the prefix
# key and for copy mode. Domain: empty, or 1..4 characters excluding
# " ' \ $ ; # and newlines. Empty means "use the glyph set's own accent mark",
# which is the recommended setting.
set -ogq @sentinel_accent ""

# Free disk space, in whole gigabytes, below which the disk segment turns
# warning-coloured (and, under alerts_only, becomes visible at all).
# Domain: integer 0..100000. Comparison is strict `<`.
set -ogq @sentinel_disk_warn_gb "25"

# Free disk space, in whole gigabytes, below which the disk segment turns
# alert-coloured. Domain: integer 0..100000. Comparison is strict `<`.
set -ogq @sentinel_disk_crit_gb "15"

# CPU utilisation percentage at or above which the cpu segment turns
# warning-coloured. Domain: integer 0..100. Comparison is `>=`.
set -ogq @sentinel_cpu_warn_pct "70"

# CPU utilisation percentage at or above which the cpu segment turns
# alert-coloured. Domain: integer 0..100. Comparison is `>=`.
set -ogq @sentinel_cpu_crit_pct "90"

# Battery charge percentage below which a discharging battery turns
# peach-coloured and takes the half-full icon. Domain: integer 0..100.
set -ogq @sentinel_battery_warn_pct "50"

# Battery charge percentage below which a discharging battery turns
# alert-coloured and takes the low icon. Domain: integer 0..100.
set -ogq @sentinel_battery_crit_pct "20"
